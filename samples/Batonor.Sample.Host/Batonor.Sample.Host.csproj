<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Batonor.Sample.Host</RootNamespace>
    <AssemblyName>Batonor.Sample.Host</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Batonor.Abstractions\Batonor.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Batonor.Core\Batonor.Core.csproj" />
    <ProjectReference Include="..\..\src\Batonor.Expressions\Batonor.Expressions.csproj" />
    <ProjectReference Include="..\..\src\Batonor.Json\Batonor.Json.csproj" />
    <ProjectReference Include="..\..\src\Batonor.Persistence.Sqlite\Batonor.Persistence.Sqlite.csproj" />
    <!-- Batonor.SourceGen is consumed as a NuGet analyzer package (a project reference to a
         netstandard2.0 generator would be flagged NETSDK1207 under PublishAot). -->
    <PackageReference Include="Batonor.SourceGen" Version="1.0.0" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <!-- The workflow definition is config-driven: loaded from workflow.json at runtime. -->
    <Content Include="workflow.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
